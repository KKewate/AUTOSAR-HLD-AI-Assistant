# =============================================================================
# AUTOSAR HLD AI Assistant — Environment Configuration
# =============================================================================
# Copy this file to .env and configure your values.
# NEVER commit .env to version control (.gitignore excludes it).
# =============================================================================

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one provider:
#
#   mock   — No LLM required. Shows demo placeholders. Default for quick start.
#   ollama — FREE local LLM via Ollama (recommended for real answers).
#            Install: https://ollama.ai
#            Then run: ollama pull llama3.1 && ollama serve
#   openai — OpenAI API (requires OPENAI_API_KEY below)
#
LLM_PROVIDER=mock

# ── Model Name ────────────────────────────────────────────────────────────────
# For Ollama: llama3.1, llama3.2, mistral, phi3, gemma2
# For OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
LLM_MODEL=llama3.1

# ── Ollama Configuration ──────────────────────────────────────────────────────
# URL where Ollama is running (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# ── OpenAI Configuration (only needed if LLM_PROVIDER=openai) ────────────────
# Leave blank if using Ollama or mock mode.
OPENAI_API_KEY=

# ── Generation Parameters ─────────────────────────────────────────────────────
# Temperature: 0.0 = deterministic/factual, 1.0 = creative
TEMPERATURE=0.1
# Maximum tokens per LLM response
MAX_TOKENS=1500

# ── Embedding Model (local, no API key required) ──────────────────────────────
# Downloaded automatically from HuggingFace on first run (~130 MB)
# Options: BAAI/bge-small-en-v1.5 (fast), BAAI/bge-large-en-v1.5 (accurate)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Vector Database ────────────────────────────────────────────────────────────
# Only FAISS is currently supported (local, no server required)
VECTOR_DB=faiss

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of document chunks to retrieve per query
RETRIEVAL_TOP_K=5

# ── Chunking ──────────────────────────────────────────────────────────────────
# Characters per chunk (600 is a good balance for AUTOSAR docs)
CHUNK_SIZE=600
# Overlap between consecutive chunks (preserves context at boundaries)
CHUNK_OVERLAP=100
